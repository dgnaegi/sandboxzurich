/*
  X-Robots-Tag: noindex
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/tiles/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/models/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/tex/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/data/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/map/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
/fonts/*
  Cache-Control: public, max-age=31536000
